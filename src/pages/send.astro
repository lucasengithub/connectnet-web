---
import GlobalHead from "../components/GlobalHead.astro";
---

<html lang="es">
    <GlobalHead title="Enviar | connectnet" />

    <body>
        <iframe
            allow="display-capture"
            title="Enviar pantalla con connectnet"
            src="https://pantalla.systemconnect.lucaspeinado.es/enviar/"
        ></iframe>
    </body>

    <style>
        body {
            overflow: hidden;
            background-color: #000000;
        }

        iframe {
            position: fixed;
            inset: 0;
            z-index: 0;
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            border: 0;
            background-color: #000000;
        }
    </style>

    <script>
        if (
            /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
                navigator.userAgent,
            )
        ) {
            alert(
                "Tu navegador no soporta el envío de pantalla.\nEstamos desarrollando una App para solventarlo.",
            );
            window.location.href = "/";
        }
    </script>
</html>
