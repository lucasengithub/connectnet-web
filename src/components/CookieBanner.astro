<aside class="cookie-banner" id="cookie-banner" role="region" aria-label="Aviso de cookies">
    <p>
        <span data-i18n="cookies.text"
            >Usamos almacenamiento local técnico para recordar tu idioma y tu
            preferencia. No usamos cookies publicitarias ni de
            seguimiento.</span
        >
        <a href="/privacidad" data-i18n="cookies.more"
            >Política de privacidad</a
        >
    </p>
    <div class="cookie-actions">
        <button
            type="button"
            class="cookie-button cookie-button-ghost"
            data-cookie-choice="rejected"
            data-i18n="cookies.reject">Rechazar</button
        >
        <button
            type="button"
            class="cookie-button cookie-button-accept"
            data-cookie-choice="accepted"
            data-i18n="cookies.accept">Aceptar</button
        >
    </div>
</aside>

<script>
    const STORAGE_KEY = "connectnet-cookies";
    const banner = document.getElementById("cookie-banner");

    function storedChoice() {
        try {
            return localStorage.getItem(STORAGE_KEY);
        } catch (error) {
            return null;
        }
    }

    if (banner) {
        if (storedChoice()) {
            banner.remove();
        } else {
            requestAnimationFrame(() => banner.classList.add("is-visible"));

            banner
                .querySelectorAll("[data-cookie-choice]")
                .forEach((button) => {
                    button.addEventListener("click", () => {
                        try {
                            localStorage.setItem(
                                STORAGE_KEY,
                                button.dataset.cookieChoice,
                            );
                        } catch (error) {
                            /* Almacenamiento bloqueado: se oculta igualmente. */
                        }
                        banner.classList.remove("is-visible");
                        banner.addEventListener(
                            "transitionend",
                            () => banner.remove(),
                            { once: true },
                        );
                    });
                });
        }
    }
</script>

<style>
    .cookie-banner {
        position: fixed;
        left: 16px;
        right: 16px;
        bottom: 16px;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        max-width: 820px;
        margin: 0 auto;
        padding: 16px 20px;
        background-color: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        font-size: 0.85rem;
        line-height: 1.5;
        opacity: 0;
        transform: translateY(12px);
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }

    .cookie-banner.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .cookie-banner p {
        margin: 0;
        color: #3d3f42;
    }

    .cookie-banner a {
        color: #53c323;
        text-decoration: underline;
        text-underline-offset: 3px;
        white-space: nowrap;
    }

    .cookie-actions {
        display: flex;
        flex-shrink: 0;
        gap: 8px;
    }

    .cookie-button {
        padding: 8px 14px;
        border-radius: 8px;
        border: 1px solid transparent;
        font: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.18s ease;
    }

    .cookie-button-ghost {
        background-color: transparent;
        border-color: #dcdcdc;
        color: #3d3f42;
    }

    .cookie-button-ghost:hover {
        background-color: #f4f4f4;
    }

    .cookie-button-accept {
        background-color: #53c323;
        color: #0b1a05;
    }

    .cookie-button-accept:hover {
        background-color: #67d63a;
    }

    .cookie-button:focus-visible,
    .cookie-banner a:focus-visible {
        outline: 2px solid #53c323;
        outline-offset: 2px;
    }

    @media screen and (max-width: 640px) {
        .cookie-banner {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
            text-align: left;
        }

        .cookie-actions {
            justify-content: flex-end;
        }
    }
</style>
